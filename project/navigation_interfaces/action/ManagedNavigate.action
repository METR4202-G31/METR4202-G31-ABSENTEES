# Feedback

uint8 CHECKING_GOAL=0
uint8 PLANNING=1
uint8 NAVIGATING=2
uint8 CANCELING=3

uint8 state
float32 distance_remaining
builtin_interfaces/Duration navigation_time
uint16 recovery_count