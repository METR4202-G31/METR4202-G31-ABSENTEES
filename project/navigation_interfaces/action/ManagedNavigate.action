# Result

uint8 SUCCEEDED=0
uint8 BLACKLISTED=1
uint8 PLANNING_FAILED=2
uint8 NAVIGATION_FAILED=3
uint8 STUCK=4
uint8 CANCELED=5
uint8 INVALID_GOAL=6
uint8 INTERNAL_ERROR=7

